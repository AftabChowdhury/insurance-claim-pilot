# ---------- OpenAI (default) ----------
OPENAI_API_KEY=sk-...
# Change to the models you have access to
OPENAI_MODEL=gpt-4.1
OPENAI_MINI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072
# Set to empty if your model does not accept a temperature (some reasoning models)
LLM_TEMPERATURE=0

# ---------- Azure OpenAI (optional; if AZURE_OPENAI_ENDPOINT is set it is used instead of OpenAI) ----------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_MINI_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# ---------- Azure AI Search ----------
AZURE_SEARCH_ENDPOINT=https://claimpilot-fiq.search.windows.net
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=claimpilot-policies
SEMANTIC_CONFIG=claimpilot-semantic

# ---------- Workflow rules ----------
HITL_PAYOUT_THRESHOLD=10000
FRAUD_REVIEW_THRESHOLD=0.7
EVAL_THRESHOLD=0.8
MAX_RETRIES=2
RETRIEVAL_TOP_K=6
MIN_RERANKER_SCORE=1.5

# ---------- MCP servers ----------
CLAIMS_MCP_URL=http://localhost:8001/mcp
POLICY_MCP_URL=http://localhost:8002/mcp
FRAUD_MCP_URL=http://localhost:8003/mcp

# ---------- Admin panel (static demo login) ----------
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=admin
# Secret used to sign admin login tokens – change it
ADMIN_TOKEN_SECRET=change-me
ADMIN_TOKEN_TTL_MINUTES=480
POLICY_MAX_FILES=20
POLICY_MAX_MB=25
# Index uploaded policies automatically (background) and resync on API start
POLICY_AUTO_INDEX=true

# ---------- Policy extraction (vision model = the chat deployment, e.g. gpt-4.1) ----------
IMAGE_DESCRIBE=true
IMAGE_MIN_PX=120
IMAGE_MAX_PER_DOC=50
SCAN_OCR=true
VISION_CONCURRENCY=4
# Needed only for .doc files; e.g. C:\Program Files\LibreOffice\program\soffice.exe
LIBREOFFICE_PATH=soffice

# ---------- Chunking (tokens; same for all file formats; re-index after changing) ----------
CHUNK_TARGET_TOKENS=450
CHUNK_MAX_TOKENS=700
CHUNK_OVERLAP_TOKENS=60
CHUNK_MIN_TOKENS=40
EMBED_BATCH_SIZE=64

# ---------- Policy chat ----------
CHAT_EVAL_THRESHOLD=0.8
CHAT_MIN_RELEVANCE=0.7
CHAT_MIN_CITATION_COVERAGE=0.7
CHAT_MAX_RETRIES=2
CHAT_TOP_K=6
CHAT_HISTORY_TURNS=6
CHAT_RATE_LIMIT_PER_MIN=20
# Reranker score (0-4) above which a confidential chunk counts as "the answer is in a confidential document"
CONFIDENTIAL_PROBE_MIN_SCORE=2.0
# Confidential score this much above the best public score -> treat as restricted (public hits only loosely related)
CONFIDENTIAL_DOMINANCE_MARGIN=1.0
# CONFIDENTIAL_MESSAGE="Some of the information you asked about is in a confidential document, ..."

# ---------- UI ----------
API_URL=http://localhost:8000

# ---------- LangSmith observability (optional) ----------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=claimpilot
