# ---------- OpenAI (default) ----------
OPENAI_API_KEY=sk-...
# Change to the models you have access to
OPENAI_MODEL=gpt-4.1
OPENAI_MINI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072
# Set to empty if your model does not accept a temperature (some reasoning models)
LLM_TEMPERATURE=0

# ---------- Azure OpenAI (optional; if AZURE_OPENAI_ENDPOINT is set it is used instead of OpenAI) ----------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_MINI_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# ---------- Azure AI Search ----------
AZURE_SEARCH_ENDPOINT=https://claimpilot-fiq.search.windows.net
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=claimpilot-policies
SEMANTIC_CONFIG=claimpilot-semantic

# ---------- Workflow rules ----------
HITL_PAYOUT_THRESHOLD=10000
FRAUD_REVIEW_THRESHOLD=0.7
EVAL_THRESHOLD=0.8
MAX_RETRIES=2
RETRIEVAL_TOP_K=6
MIN_RERANKER_SCORE=1.5

# ---------- MCP servers ----------
CLAIMS_MCP_URL=http://localhost:8001/mcp
POLICY_MCP_URL=http://localhost:8002/mcp
FRAUD_MCP_URL=http://localhost:8003/mcp

# ---------- Admin panel (static demo login) ----------
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=admin
# Secret used to sign admin login tokens – change it
ADMIN_TOKEN_SECRET=change-me
ADMIN_TOKEN_TTL_MINUTES=480
POLICY_MAX_FILES=20
POLICY_MAX_MB=25

# ---------- UI ----------
API_URL=http://localhost:8000

# ---------- LangSmith observability (optional) ----------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=claimpilot
